{
  "name": "wm-yt-feed",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "register-commands": "tsx src/discord/register-commands.ts"
  },
  "dependencies": {
    "discord.js": "^14.16.3",
    "better-sqlite3": "^11.5.0",
    "drizzle-orm": "^0.45.3",
    "rss-parser": "^3.13.0",
    "node-cron": "^4.6.0",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.17.6",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.15.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0",
    "vitest": "^2.1.9"
  }
}
